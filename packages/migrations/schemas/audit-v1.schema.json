{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:craft:migration-audit:1",
  "title": "MigrationAuditV1",
  "anyOf": [
    {
      "$ref": "#/$defs/Plan"
    },
    {
      "$ref": "#/$defs/Report"
    },
    {
      "$ref": "#/$defs/Journal"
    },
    {
      "$ref": "#/$defs/DecisionRecord"
    },
    {
      "$ref": "#/$defs/Attestation"
    }
  ],
  "$defs": {
    "JsonValue": {
      "anyOf": [
        {
          "type": [
            "string",
            "number",
            "boolean",
            "null"
          ]
        },
        {
          "type": "array",
          "items": {
            "$ref": "#/$defs/JsonValue"
          }
        },
        {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/JsonValue"
          }
        }
      ]
    },
    "Versions": {
      "type": "object",
      "properties": {
        "core": {
          "type": "integer",
          "minimum": 1
        }
      },
      "required": [
        "core"
      ],
      "additionalProperties": {
        "type": "integer",
        "minimum": 1
      }
    },
    "Diagnostic": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "code": {
          "type": "string",
          "minLength": 1
        },
        "message": {
          "type": "string",
          "minLength": 1
        },
        "severity": {
          "enum": [
            "error",
            "warning"
          ]
        },
        "path": {
          "type": "string",
          "minLength": 1
        },
        "pointer": {
          "type": "string"
        },
        "line": {
          "type": "integer",
          "minimum": 1
        },
        "column": {
          "type": "integer",
          "minimum": 1
        }
      },
      "required": [
        "code",
        "message",
        "severity",
        "path",
        "pointer"
      ]
    },
    "SourceMapping": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1
        },
        "before": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[a-f0-9]{64}$"
        },
        "after": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[a-f0-9]{64}$"
        }
      },
      "required": [
        "path",
        "before",
        "after"
      ]
    },
    "SemanticMapping": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "entity_id": {
          "type": "string",
          "minLength": 1
        },
        "revision_id": {
          "type": "string",
          "minLength": 1
        },
        "before_semantic_digest": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "after_semantic_digest": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "before_dependency_digest": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "after_dependency_digest": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      },
      "required": [
        "entity_id",
        "revision_id",
        "before_semantic_digest",
        "after_semantic_digest",
        "before_dependency_digest",
        "after_dependency_digest"
      ]
    },
    "ReviewMapping": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1
        },
        "status": {
          "enum": [
            "semantic_continuity_verified",
            "revalidation_required"
          ]
        },
        "reason": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "path",
        "status",
        "reason"
      ]
    },
    "ContextMapping": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1
        },
        "index": {
          "type": "integer",
          "minimum": 0
        },
        "status": {
          "enum": [
            "semantic_continuity_verified",
            "revalidation_required"
          ]
        },
        "before_source_digest": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "after_source_digest": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[a-f0-9]{64}$"
        }
      },
      "required": [
        "path",
        "index",
        "status",
        "before_source_digest",
        "after_source_digest"
      ]
    },
    "Report": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "schemaValid": {
          "type": "boolean"
        },
        "referencesValid": {
          "type": "boolean"
        },
        "semanticChecksPassed": {
          "type": "boolean"
        },
        "sourceMappings": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/SourceMapping"
          }
        },
        "semanticMappings": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/SemanticMapping"
          }
        },
        "reviewMappings": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/ReviewMapping"
          }
        },
        "contextMappings": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/ContextMapping"
          }
        },
        "payloadDiffDigest": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "diagnostics": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Diagnostic"
          }
        },
        "beforeSemanticModelVersion": {
          "type": "integer",
          "minimum": 1
        },
        "afterSemanticModelVersion": {
          "type": "integer",
          "minimum": 1
        }
      },
      "required": [
        "schemaValid",
        "referencesValid",
        "semanticChecksPassed",
        "sourceMappings",
        "semanticMappings",
        "reviewMappings",
        "contextMappings",
        "payloadDiffDigest",
        "diagnostics",
        "beforeSemanticModelVersion",
        "afterSemanticModelVersion"
      ]
    },
    "Answer": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "requestDigest": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "value": {
          "$ref": "#/$defs/JsonValue"
        },
        "rationale": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "requestDigest",
        "value",
        "rationale"
      ]
    },
    "Answers": {
      "type": "object",
      "additionalProperties": {
        "$ref": "#/$defs/Answer"
      }
    },
    "Request": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "key": {
          "type": "string",
          "minLength": 1
        },
        "prompt": {
          "type": "string",
          "minLength": 1
        },
        "requestDigest": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "valueSchema": {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/JsonValue"
          }
        }
      },
      "required": [
        "key",
        "prompt",
        "requestDigest",
        "valueSchema"
      ]
    },
    "Step": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "implementationDigest": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      },
      "required": [
        "id",
        "implementationDigest"
      ]
    },
    "Plan": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "registryId": {
          "type": "string",
          "minLength": 1
        },
        "from": {
          "$ref": "#/$defs/Versions"
        },
        "to": {
          "$ref": "#/$defs/Versions"
        },
        "sourceFingerprint": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "steps": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Step"
          }
        },
        "expectedFiles": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "decisions": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Request"
          }
        },
        "warnings": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "codecs": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "fromId": {
              "type": "string",
              "minLength": 1
            },
            "fromDigest": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            },
            "toId": {
              "type": "string",
              "minLength": 1
            },
            "toDigest": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            }
          },
          "required": [
            "fromId",
            "fromDigest",
            "toId",
            "toDigest"
          ]
        }
      },
      "required": [
        "registryId",
        "from",
        "to",
        "sourceFingerprint",
        "steps",
        "expectedFiles",
        "decisions",
        "warnings",
        "codecs"
      ]
    },
    "Guard": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "root": {
          "type": "string",
          "minLength": 1
        },
        "commonDir": {
          "type": "string",
          "minLength": 1
        },
        "commit": {
          "type": "string",
          "pattern": "^(?:[a-f0-9]{40}|[a-f0-9]{64})$"
        },
        "indexDigest": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[a-f0-9]{64}$"
        },
        "status": {
          "type": "string"
        },
        "fingerprint": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      },
      "required": [
        "root",
        "commonDir",
        "commit",
        "indexDigest",
        "status",
        "fingerprint"
      ]
    },
    "Workspace": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1
        },
        "branch": {
          "type": "string",
          "minLength": 1
        },
        "baseCommit": {
          "type": "string",
          "pattern": "^(?:[a-f0-9]{40}|[a-f0-9]{64})$"
        },
        "sourceRoot": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "path",
        "branch",
        "baseCommit",
        "sourceRoot"
      ]
    },
    "Journal": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "protocol": {
          "const": 1
        },
        "runId": {
          "type": "string",
          "pattern": "^mig_[a-f0-9-]+$"
        },
        "registryId": {
          "type": "string",
          "minLength": 1
        },
        "state": {
          "enum": [
            "starting",
            "waiting_for_decision",
            "staged",
            "publishing",
            "completed",
            "failed",
            "review_required"
          ]
        },
        "source": {
          "$ref": "#/$defs/Guard"
        },
        "workspace": {
          "$ref": "#/$defs/Workspace"
        },
        "basisPlanDigest": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "planDigest": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "workspaceGuard": {
          "$ref": "#/$defs/Guard"
        },
        "answersFile": {
          "type": "string",
          "minLength": 1
        },
        "resultCommit": {
          "type": "string",
          "pattern": "^(?:[a-f0-9]{40}|[a-f0-9]{64})$"
        },
        "resultFingerprint": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "error": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "code": {
              "type": "string",
              "minLength": 1
            },
            "message": {
              "type": "string",
              "minLength": 1
            }
          },
          "required": [
            "code",
            "message"
          ]
        }
      },
      "required": [
        "protocol",
        "runId",
        "registryId",
        "state",
        "source",
        "workspace",
        "basisPlanDigest",
        "planDigest",
        "createdAt"
      ]
    },
    "DecisionRecord": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "protocol": {
          "const": 1
        },
        "id": {
          "type": "string",
          "minLength": 1
        },
        "registry_id": {
          "type": "string",
          "minLength": 1
        },
        "basis_fingerprint": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "answers": {
          "$ref": "#/$defs/Answers"
        },
        "created_at": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "protocol",
        "id",
        "registry_id",
        "basis_fingerprint",
        "answers",
        "created_at"
      ]
    },
    "Attestation": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "protocol": {
          "const": 1
        },
        "id": {
          "type": "string",
          "minLength": 1
        },
        "registry_id": {
          "type": "string",
          "minLength": 1
        },
        "base_commit": {
          "type": "string",
          "pattern": "^(?:[a-f0-9]{40}|[a-f0-9]{64})$"
        },
        "from": {
          "$ref": "#/$defs/Versions"
        },
        "to": {
          "$ref": "#/$defs/Versions"
        },
        "steps": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Step"
          }
        },
        "report": {
          "$ref": "#/$defs/Report"
        },
        "decisions_digest": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "created_at": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "protocol",
        "id",
        "registry_id",
        "base_commit",
        "from",
        "to",
        "steps",
        "report",
        "decisions_digest",
        "created_at"
      ]
    }
  }
}
