{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:craft:fixture:person:2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "given_name",
    "family_name",
    "display_order"
  ],
  "properties": {
    "given_name": {
      "type": "string",
      "minLength": 1
    },
    "family_name": {
      "type": "string",
      "minLength": 1
    },
    "display_order": {
      "enum": [
        "given_family",
        "family_given"
      ]
    }
  }
}
