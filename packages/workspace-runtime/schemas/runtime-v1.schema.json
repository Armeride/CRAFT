{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:craft:workspace-runtime:1",
  "title": "WorkspaceRuntimeV1",
  "anyOf": [
    {
      "$ref": "#/$defs/Registration"
    },
    {
      "$ref": "#/$defs/Run"
    },
    {
      "$ref": "#/$defs/Operation"
    },
    {
      "$ref": "#/$defs/Transaction"
    }
  ],
  "$defs": {
    "Registration": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "protocol": {
          "const": 1
        },
        "id": {
          "type": "string",
          "minLength": 1
        },
        "root": {
          "type": "string",
          "minLength": 1
        },
        "commonDir": {
          "type": "string",
          "minLength": 1
        },
        "projectId": {
          "type": [
            "string",
            "null"
          ]
        },
        "selectedRef": {
          "type": [
            "string",
            "null"
          ]
        },
        "head": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^(?:[a-f0-9]{40}|[a-f0-9]{64})$"
        },
        "status": {
          "enum": [
            "ready",
            "import_required",
            "unborn",
            "unsupported",
            "invalid"
          ]
        },
        "remoteUrl": {
          "type": "string",
          "minLength": 1
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "protocol",
        "id",
        "root",
        "commonDir",
        "projectId",
        "selectedRef",
        "head",
        "status",
        "createdAt"
      ]
    },
    "Run": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "protocol": {
          "const": 1
        },
        "registrationId": {
          "type": "string",
          "minLength": 1
        },
        "projectId": {
          "type": "string",
          "minLength": 1
        },
        "taskId": {
          "type": "string",
          "minLength": 1
        },
        "runId": {
          "type": "string",
          "minLength": 1
        },
        "worktreeId": {
          "type": "string",
          "minLength": 1
        },
        "branch": {
          "type": "string",
          "minLength": 1
        },
        "path": {
          "type": "string",
          "minLength": 1
        },
        "basisCommit": {
          "type": "string",
          "pattern": "^(?:[a-f0-9]{40}|[a-f0-9]{64})$"
        },
        "targetRef": {
          "type": "string",
          "minLength": 1
        },
        "status": {
          "enum": [
            "queued",
            "starting",
            "running",
            "waiting_for_input",
            "cancelling",
            "completed",
            "failed",
            "cancelled",
            "interrupted",
            "unknown"
          ]
        },
        "workspaceState": {
          "enum": [
            "present",
            "removed",
            "missing",
            "recovering"
          ]
        },
        "cancelRequested": {
          "type": "boolean"
        },
        "omittedWorkingChanges": {
          "type": "boolean"
        },
        "selectedSnapshotRef": {
          "type": "string",
          "minLength": 1
        },
        "initialCommit": {
          "type": "string",
          "pattern": "^(?:[a-f0-9]{40}|[a-f0-9]{64})$"
        },
        "headCommit": {
          "type": "string",
          "pattern": "^(?:[a-f0-9]{40}|[a-f0-9]{64})$"
        },
        "checkpointId": {
          "type": "string",
          "minLength": 1
        },
        "resumedFrom": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "ref": {
              "type": "string",
              "minLength": 1
            },
            "commit": {
              "type": "string",
              "pattern": "^(?:[a-f0-9]{40}|[a-f0-9]{64})$"
            },
            "checkpointId": {
              "type": "string",
              "minLength": 1
            }
          },
          "required": [
            "ref",
            "commit",
            "checkpointId"
          ]
        },
        "validation": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "valid": {
              "type": "boolean"
            },
            "codes": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              }
            }
          },
          "required": [
            "valid",
            "codes"
          ]
        },
        "error": {
          "type": "string",
          "minLength": 1
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "protocol",
        "registrationId",
        "projectId",
        "taskId",
        "runId",
        "worktreeId",
        "branch",
        "path",
        "basisCommit",
        "targetRef",
        "status",
        "workspaceState",
        "cancelRequested",
        "omittedWorkingChanges",
        "createdAt"
      ]
    },
    "Operation": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "protocol": {
          "const": 1
        },
        "id": {
          "type": "string",
          "minLength": 1
        },
        "kind": {
          "enum": [
            "snapshot",
            "import",
            "integration"
          ]
        },
        "registrationId": {
          "type": "string",
          "minLength": 1
        },
        "path": {
          "type": "string",
          "minLength": 1
        },
        "branch": {
          "type": "string",
          "minLength": 1
        },
        "basisCommit": {
          "type": "string",
          "pattern": "^(?:[a-f0-9]{40}|[a-f0-9]{64})$"
        },
        "status": {
          "enum": [
            "starting",
            "ready",
            "completed",
            "failed"
          ]
        },
        "resultCommit": {
          "type": "string",
          "pattern": "^(?:[a-f0-9]{40}|[a-f0-9]{64})$"
        },
        "inputCommit": {
          "type": "string",
          "pattern": "^(?:[a-f0-9]{40}|[a-f0-9]{64})$"
        },
        "error": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "protocol",
        "id",
        "kind",
        "registrationId",
        "path",
        "branch",
        "basisCommit",
        "status"
      ]
    },
    "SourceFile": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1
        },
        "text": {
          "type": "string"
        },
        "contentBase64": {
          "type": "string"
        },
        "digest": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      },
      "required": [
        "path",
        "contentBase64",
        "digest"
      ]
    },
    "Edit": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1
        },
        "before": {
          "anyOf": [
            {
              "$ref": "#/$defs/SourceFile"
            },
            {
              "type": "null"
            }
          ]
        },
        "after": {
          "anyOf": [
            {
              "$ref": "#/$defs/SourceFile"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "path",
        "before",
        "after"
      ]
    },
    "Transaction": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "protocol": {
          "const": 1
        },
        "id": {
          "type": "string",
          "minLength": 1
        },
        "scopeId": {
          "type": "string",
          "minLength": 1
        },
        "root": {
          "type": "string",
          "minLength": 1
        },
        "branch": {
          "type": "string",
          "minLength": 1
        },
        "beforeFingerprint": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "afterFingerprint": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "state": {
          "enum": [
            "prepared",
            "writing",
            "applied",
            "conflict"
          ]
        },
        "edits": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Edit"
          }
        },
        "completed": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "error": {
          "type": "string",
          "minLength": 1
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "protocol",
        "id",
        "scopeId",
        "root",
        "branch",
        "beforeFingerprint",
        "afterFingerprint",
        "state",
        "edits",
        "completed",
        "createdAt"
      ]
    }
  }
}
