{
  "name": "craft",
  "version": "0.0.0",
  "private": true,
  "description": "CRAFT local-first novel and game planning workspace",
  "type": "module",
  "engines": {
    "node": "24.21.0",
    "npm": "11.19.0"
  },
  "packageManager": "npm@11.19.0",
  "scripts": {
    "typecheck": "npm run typecheck:core && tsc -p apps/web/tsconfig.json",
    "build": "tsc -p tsconfig.build.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "npm run schema:check && npm run typecheck && npm run build && npm run ui:build && npm test",
    "schema:types": "node tools/schema-types.mjs",
    "schema:check": "node tools/schema-types.mjs --check",
    "project:validate": "node dist/tools/project-cli.js validate",
    "project:get": "node dist/tools/project-cli.js get",
    "project:baseline": "node dist/tools/project-cli.js baseline",
    "migration": "node dist/tools/migration-cli.js",
    "workspace": "node dist/tools/workspace-cli.js",
    "index": "node dist/tools/index-cli.js",
    "typecheck:core": "tsc --noEmit",
    "ui:build": "vite build --config apps/web/vite.config.ts",
    "ui:preview": "npm run build && npm run ui:build && node dist/tools/ui-preview.js",
    "test:ui": "playwright test"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@playwright/test": "1.65.0",
    "@types/better-sqlite3": "9.6.0",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "json-schema-to-typescript": "16.0.0",
    "typescript": "7.0.2",
    "vite": "8.3.8",
    "vitest": "5.1.0"
  },
  "allowScripts": {
    "better-sqlite3@13.0.3": true
  },
  "dependencies": {
    "@fastify/static": "10.1.10",
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1",
    "better-sqlite3": "13.0.3",
    "fastify": "5.12.8",
    "fs-native-extensions": "1.5.3",
    "i18next": "27.1.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-i18next": "18.0.1",
    "yaml": "2.9.1"
  }
}
