{
  "compilerOptions": {
    "target": "ES2023", "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "module": "ESNext", "moduleResolution": "Bundler", "jsx": "react-jsx",
    "strict": true, "noUncheckedIndexedAccess": true, "exactOptionalPropertyTypes": true,
    "verbatimModuleSyntax": true, "skipLibCheck": false, "noEmit": true,
    "allowImportingTsExtensions": true, "resolveJsonModule": true, "types": ["vite/client"]
  },
  "include": ["src/**/*.ts", "src/**/*.tsx"], "exclude": ["**/*.test.ts"]
}
